VITE_API_BASE_URL=https://neryva-backend.vercel.app/api/v1

# ngrok tunnel (used only when `npm run dev -- --tunnel` is passed).
# Copy these into your local .env (which is gitignored).
NGROK_AUTHTOKEN=
NGROK_BIN=ngrok
NGROK_URL=https://<your-domain>.ngrok-free.dev

# Tailscale Funnel (used only when `npm run dev -- --tunnel funnel` is passed).
# No token needed — auth comes from `tailscale up` in your terminal.
# TAILSCALE_BIN is only needed if tailscale isn't on PATH.
# TAILSCALE_BIN=C:\Program Files\Tailscale\tailscale.exe
